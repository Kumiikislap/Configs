{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    "source": "/home/kumii39/Documents/Amechan2.txt",
        "type": "file",
    "color": {
        "1": "black",
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "separator": "1" // Bold
        },
        "constants": [
            "───────────────────────────"
        ],
        "key": {
            "type": "both",
            "paddingLeft": 1
        }
    },
    "modules": [
        {
            "keyColor": "magenta",
            "type": "title",
            "format": "                  {user-name-colored}{at-symbol-colored}{host-name-colored}",
        },
        "break",
        {
            "type": "custom",
            "format": "┌{$1}{$1}┐"
        },
        "break",
        {
            "key": "OS        ",
            "keyColor": "red",
            "type": "os"
        },
        {
            "key": "Machine   ",
            "keyColor": "green",
            "type": "host"
        },
        {
            "key": "Kernel    ",
            "keyColor": "magenta",
            "type": "kernel"
        },
        {
            "key": "Uptime    ",
            "keyColor": "red",
            "type": "uptime"
        },
        {
            "key": "Resolution",
            "keyColor": "magenta",
            "type": "display",
            "compactType": "original-with-refresh-rate"
        },
        {
            "key": "WM        ",
            "keyColor": "blue",
            "type": "wm"
        },
        {
            "key": "DE        ",
            "keyColor": "green",
            "type": "de"
        },
        {
            "key": "Theme     ",
            "keyColor": "cyan",
            "type": "wmtheme"
        },
        {
            "key": "Icons     ",
            "keyColor": "yellow",
            "type": "icons"
        },
        {
            "key": "Shell     ",
            "keyColor": "blue",
            "type": "shell"
        },
        {
            "key": "Terminal  ",
            "keyColor": "red",
            "type": "terminal"
        },
        {
            "key": "CPU       ",
            "keyColor": "red",
            "type": "cpu",
            "format": "AMD Ryzen 5 5600G @ 4.46Ghz"
        },
        {
            "key": "GPU       ",
            "keyColor": "blue",
            "type": "gpu",
            "format": "AMD Radeon Integrated Femboy"
        },
        {
            "key": "Memory    ",
            "keyColor": "magenta",
            "type": "memory"
        },
        {
            "key": "Local IP  ",
            "keyColor": "red",
            "type": "localip",
            "compact": true
        },
        "break",
        {
            "type": "custom",
            "format": "└{$1}{$1}┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 17,
            "symbol": "circle"
        }

    ]
}
